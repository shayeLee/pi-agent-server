# Copy this file to .env.local for local development.
# Do not put credentials, tokens, or API keys in this tracked example.

DATA_DIR=/tmp/pi-agent-server
PI_ALLOWED_CLIENT_CIDRS=127.0.0.0/8,10.0.0.0/8
PI_DEFAULT_MODEL=openai-codex/gpt-5.6-luna
PI_DEFAULT_THINKING_LEVEL=medium

# Pi resource directory containing models.json and auth.json. Use an absolute path.
PI_AGENT_DIR=/absolute/path/to/pi-agent

# Explicit linked plugin package. Leave empty/unset when the plugin is not installed.
PI_PLUGINS=pi-agent-capability-onev

# Explicit Pi provider extensions (absolute paths or ~/..., comma-separated).
# Each path is loaded as-is with automatic discovery still disabled; a configured
# path that fails to load rejects startup. Example (already present on this machine):
# PI_PROVIDER_EXTENSION_PATHS=~/.pi/packages/pi-workbuddy-connect

# Set AGENT_CWD to the onev checkout root when using the linked plugin.
AGENT_CWD=/absolute/path/to/onev
ONEV_DATA_DIR=/absolute/path/to/pi-agent-capability-onev-data

# Explicit absolute executable paths; replace these placeholders with local paths.
ONEV_DWS_BIN=/absolute/path/to/dws
ONEV_VUE2_INDEX_BIN=/absolute/path/to/vue2-index
ONEV_GITNEXUS_BIN=/absolute/path/to/gitnexus
# ONEV_DWS_ENABLED=true

# Keep authentication in ~/.pi/agent/auth.json or another secret mechanism.
# Never commit PI_AUTH_PATH contents, PI_MODEL_API_KEY, or any token.
