# Copy this file to .env.local for local development.
# Do not put credentials, tokens, or API keys in this tracked example.

DATA_DIR=/tmp/pi-agent-server
PI_ALLOWED_CLIENT_CIDRS=127.0.0.0/8,10.0.0.0/8
PI_DEFAULT_MODEL=openai-codex/gpt-5.6-luna
PI_DEFAULT_THINKING_LEVEL=medium

# Pi resource directory containing models.json and auth.json. Use an absolute path.
PI_AGENT_DIR=/absolute/path/to/pi-agent

# Explicit plugin specifier(s), comma-separated. Leave empty/unset when no plugin is installed.
# Either a package name (requires `pnpm link` in dev) or an absolute path to a built
# entry file (stable for bare-metal: survives a node_modules rebuild).
# PI_PLUGINS=/absolute/path/to/trusted-plugin/dist/index.js
# Dev alternative: link a trusted plugin into this repo and use its package name.

# Explicit Pi SDK extensions (absolute paths or ~/..., comma-separated).
# Automatic discovery remains disabled. Invalid paths or load failures reject startup.
# PI_EXTENSION_PATHS=/absolute/path/to/pi-extension
# Deprecated compatibility alias; warns if used alone. Do not set both non-empty lists.
# PI_PROVIDER_EXTENSION_PATHS=/absolute/path/to/pi-extension

# The project directory in which Agent tools operate. Use an existing absolute path.
AGENT_CWD=/absolute/path/to/workspace

# Keep authentication in ~/.pi/agent/auth.json or another secret mechanism.
# Never commit PI_AUTH_PATH contents, PI_MODEL_API_KEY, or any token.
