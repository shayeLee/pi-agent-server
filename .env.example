# Copy this file to .env.local for local development.
# Do not put credentials, tokens, or API keys in this tracked example.

# Explicit disposable development example, not the default. Both dev:real and
# dev:real:init default to ~/.pi when DATA_DIR is unset or blank.
DATA_DIR=/tmp/pi-agent-server
PI_ALLOWED_CLIENT_CIDRS=127.0.0.0/8,10.0.0.0/8
PI_DEFAULT_MODEL=openai-codex/gpt-5.6-luna
PI_DEFAULT_THINKING_LEVEL=medium

# Optional whole system prompt override (existing PI_SYSTEM_PROMPT semantics).
# PI_SYSTEM_PROMPT="You are a helpful assistant."
# PI_APPEND_SYSTEM is literal text, never a file path; unset/empty/blank adds nothing.
# Valid text keeps its whitespace/newlines. Order: default/override -> literal text -> file text -> capability fragments.
# Restart the server and create a new session after changes; frozen sessions keep their snapshot.
# APPEND_SYSTEM.md automatic discovery stays disabled.
# PI_APPEND_SYSTEM="Always answer concisely."
# Explicit UTF-8 file, read once at startup; same snapshot for every project/new session.
# Unset/empty/blank path means no read; trim path edges. Absolute paths supported;
# relative paths use service-start process.cwd(), NOT AGENT_CWD/project cwd. No ~ expansion.
# Preserve multiline whitespace; empty/blank content is ignored. Missing/unreadable files,
# directories/non-regular files or invalid UTF-8 fail startup (variable/path only, no body).
# Programmatic equivalent: StartConfig.appendSystemPromptFile. Changes need restart + new session.
# PI_APPEND_SYSTEM_FILE="./server-prompt.txt"

# TOOLS unset/empty/blank allows all available tools, including execution/writes and
# explicitly loaded extension/plugin tools. Set a complete whitelist to restrict them.
# Read-only selection (not a filesystem sandbox):
# TOOLS=read,ls,find,grep

# Pi resource directory containing models.json and auth.json. Use an absolute path.
PI_AGENT_DIR=/absolute/path/to/pi-agent

# Explicit plugin specifier(s), comma-separated. Leave empty/unset when no plugin is installed.
# Either a package name (requires `pnpm link` in dev) or an absolute path to a built
# entry file (stable for bare-metal: survives a node_modules rebuild).
# PI_PLUGINS=/absolute/path/to/trusted-plugin/dist/index.js
# Dev alternative: link a trusted plugin into this repo and use its package name.

# Explicit Pi SDK extensions (absolute paths or ~/..., comma-separated).
# Automatic discovery remains disabled. Invalid paths or load failures reject startup.
# PI_EXTENSION_PATHS=/absolute/path/to/pi-extension
# Deprecated compatibility alias; warns if used alone. Do not set both non-empty lists.
# PI_PROVIDER_EXTENSION_PATHS=/absolute/path/to/pi-extension

# Native v3 sessions are SHARED with all network-admitted users, subject to existing RBAC.
# Web-created sessions stay private. No source copy/migration/deletion; no concurrent CLI use.
# Native source defaults to CLI PI_CODING_AGENT_DIR + /sessions, otherwise ~/.pi/agent/sessions.
# Independent of server PI_AGENT_DIR and DATA_DIR. Missing source roots are not created.
# PI_SESSION_SOURCE_DIR=/absolute/path/to/native/sessions
# Exact canonical real cwd exclusions (NOT prefixes), comma split/trim/filter like PI_EXTENSION_PATHS.
# Empty/unset excludes nothing. Existing absolute directories only; invalid/missing exclusions
# fail closed, including already-indexed shared sessions. Restart after changes.
# Backup archives registered source bytes; restore requires explicit native root/cwd mapping.
# See docs/backup-restore.md; unregistered originals are outside this DB bundle.
# PI_SESSION_SHARE_EXCLUDE_CWDS=/absolute/private-project,/absolute/another-private-project

# The project directory in which Agent tools operate. Use an existing absolute path.
AGENT_CWD=/absolute/path/to/workspace

# Keep authentication in ~/.pi/agent/auth.json or another secret mechanism.
# Never commit PI_AUTH_PATH contents, PI_MODEL_API_KEY, or any token.
